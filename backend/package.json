{
  "name": "crm-v8scale-backend",
  "version": "1.0.0",
  "description": "Backend do CRM V8 Scale (Comercial e Prospecção)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reconcile-quota": "tsx prisma/reconcile-quota.ts",
    "db:reprocess-scores": "tsx prisma/reprocess-scores.ts",
    "db:reclassify-websites": "tsx prisma/reclassify-websites.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "pdfkit": "^0.15.2",
    "pino": "^10.4.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "tldts": "^7.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "undici": "^8.11.2",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "@prisma/client@5.22.0": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
