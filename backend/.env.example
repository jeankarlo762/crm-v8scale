NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_v8scale

# Gere cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (mínimo 32 caracteres, e diferentes entre si)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Obrigatório em produção (origens do front separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Primeiro acesso (só cria se o banco ainda não tiver usuários).
# Senha com letras e números, mínimo 8 caracteres; senhas óbvias são rejeitadas pelo seed.
# Se usar # ou espaços, coloque entre aspas. Depois do primeiro boot, remova as três variáveis do ambiente.
SEED_ADMIN_NAME=Administrador V8 Scale
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Contratos ───────────────────────────────────────────────────────────────
# Chave que criptografa o token do ZapSign no banco (mínimo 32 caracteres). Sem ela, usa o JWT_SECRET.
ENCRYPTION_KEY=
# Opcional: o token do ZapSign normalmente é salvo pela tela Integrações.
# ZAPSIGN_API_TOKEN=
# Dados da CONTRATADA impressos no PDF
CONTRACT_COMPANY_NAME=V8 Scale
CONTRACT_COMPANY_DOCUMENT=
CONTRACT_COMPANY_ADDRESS=
CONTRACT_COMPANY_CITY=

# Só para `npm test`: banco separado, que os testes apagam a cada execução.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_v8scale_test

# ─── Prospecção e Campanhas ─────────────────────────────────────────────────
# Campanhas de WhatsApp (Baileys) não precisam de variável: a sessão fica no banco (QR code na tela Campanhas).
# Instagram (Meta Business Discovery), opcional: sem as duas, a etapa de bio do @ é pulada.
# META_IG_BUSINESS_ID=
# META_ACCESS_TOKEN=

# Prospecao: Google Places (so backend). PLACES_MOCK=true usa dados fake, sem gastar cota
GOOGLE_PLACES_API_KEY=
PLACES_MOCK=true

# Prospecao: enriquecimento por busca web (Tavily). Opcional — sem chave, a etapa e pulada
TAVILY_API_KEY=

# ── Orçamento INTERNO das APIs externas (OBRIGATÓRIO: sem ele o provedor fica BLOQUEADO, nunca opera sem teto) ──
# Não são os limites do provedor, são tetos nossos, abaixo da franquia gratuita. Margem de segurança em API_QUOTA_SAFETY_PERCENT.
# Se a MESMA chave for usada por outro sistema, os dois dividem a cota sem enxergar o gasto um do outro:
# marque *_QUOTA_SHARED=true, informe *_EXTERNAL_RESERVED e use orçamentos menores.
# Tavily: 1.000 créditos/mês grátis; search_depth=basic = 1 crédito (o código fixa basic, sem auto_parameters).
TAVILY_MONTHLY_BUDGET=900
# Instagram/Meta (Business Discovery): exige o limite por hora.
META_HOURLY_BUDGET=100
API_QUOTA_SAFETY_PERCENT=10
# Consumo FORA deste backend com a mesma chave (outros apps/console): descontado do mensal. Não é observável aqui.
TAVILY_EXTERNAL_RESERVED=0
# Só 'true' se a conta tem plano pago/crédito assumido conscientemente (libera orçamento acima da franquia gratuita documentada).
API_QUOTA_ALLOW_ABOVE_DOCUMENTED_CAP=false

# ── Ciclo de reset de cada cota (OBRIGATÓRIO: sem isto o provedor fica BLOQUEADO). Confira no console do provedor. ──
# FIXED (calendário no fuso *_QUOTA_TZ) | ANCHOR_DAY:<1-28> (ciclo mensal que reinicia nesse dia) | ROLLING (limite móvel, conservador)
GOOGLE_PLACES_QUOTA_RESET=FIXED
GOOGLE_PLACES_QUOTA_TZ=UTC
TAVILY_QUOTA_RESET=FIXED
TAVILY_QUOTA_TZ=UTC
META_QUOTA_RESET=ROLLING
# Projeto/conta compartilhado com outras aplicações? 'true' exige *_EXTERNAL_RESERVED explícito acima.
GOOGLE_PLACES_QUOTA_SHARED=false
TAVILY_QUOTA_SHARED=false
# Consumo anterior ao contador ainda dentro da janela do provedor (os dois campos juntos):
# TAVILY_PRIOR_USAGE=0
# TAVILY_PRIOR_USAGE_UNTIL=2026-11-01T00:00:00Z
# Vigência da evidência do campo websiteUri do Google (confira os termos do Google sobre armazenar conteúdo do Places).
GOOGLE_EVIDENCE_TTL_HOURS=720
# Páginas internas (contato/sobre/unidades) lidas por candidato, por HTTP grátis.
MAX_INTERNAL_PAGES_PER_CANDIDATE=3

# ── Google Places em DUAS operações com orçamento/contador SEPARADOS (margem de segurança aplicada por operação) ──
# 1) Descoberta: Text Search PRO (id, nome, endereço, status, tipos, link) — franquia documentada 5.000/mês. Sem telefone/site/nota.
GOOGLE_TEXT_SEARCH_PRO_MONTHLY_BUDGET=5000
GOOGLE_TEXT_SEARCH_PRO_MAX_CALLS_PER_RUN=10
# Páginas por query no Text Search (20 resultados por página; máx. 3 = 60). Cada página consome 1 chamada do orçamento.
MAX_GOOGLE_PAGES_PER_QUERY=3
# 2) Enriquecimento seletivo: Place Details ENTERPRISE (telefone, website, nota, avaliações) — franquia documentada 1.000/mês.
GOOGLE_PLACE_DETAILS_ENTERPRISE_MONTHLY_BUDGET=1000
GOOGLE_PLACE_DETAILS_ENTERPRISE_MAX_CALLS_PER_RUN=20
GOOGLE_DETAILS_ENRICH_MAX_PER_REQUEST=25
# Consumo de outras aplicações / anterior ao contador, POR operação (opcional; os pares _PRIOR_USAGE e _UNTIL andam juntos):
# GOOGLE_TEXT_SEARCH_PRO_EXTERNAL_RESERVED=0
# GOOGLE_PLACE_DETAILS_ENTERPRISE_EXTERNAL_RESERVED=0
# GOOGLE_PLACE_DETAILS_ENTERPRISE_PRIOR_USAGE=0
# GOOGLE_PLACE_DETAILS_ENTERPRISE_PRIOR_USAGE_UNTIL=2026-11-01T00:00:00Z
# O ciclo/fuso/"compartilhado" (GOOGLE_PLACES_QUOTA_*, acima) vale para as duas operações.
